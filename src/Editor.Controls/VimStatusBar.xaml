<UserControl x:Class="Editor.Controls.VimStatusBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Editor.Controls">
    <StackPanel>

    <!-- Wildmenu completion bar (hidden when no completions) -->
    <Border x:Name="WildmenuBorder" Padding="6,2" Visibility="Collapsed">
        <TextBlock x:Name="WildmenuText"
                   FontFamily="Cascadia Code, Consolas" FontSize="12"
                   TextWrapping="Wrap"/>
    </Border>

    <Grid x:Name="StatusGrid" MinHeight="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Mode indicator -->
        <Border x:Name="ModeBorder" Grid.Column="0" Padding="8,2" MinWidth="80">
            <TextBlock x:Name="ModeText" FontFamily="Cascadia Code, Consolas" FontSize="13"
                       FontWeight="Bold" VerticalAlignment="Center"/>
        </Border>

        <!-- File name / Command line area ＋ Git branch ＋ Status message。
             幅はファイル欄（とコマンドライン）→ ブランチ → メッセージの順に配り、足りない分は後ろから省略する。
             以前はメッセージとブランチが Auto 列で先に幅を取り、ファイル欄が 0 近くまで縮んで [dos] [ のように途中で切れていた。 -->
        <DockPanel Grid.Column="1" LastChildFill="True">
            <Grid DockPanel.Dock="Left">
                <!-- ファイル名・改行形式・文字コード・変更印。改行形式と文字コードはホストが購読していればクリックできる
                     （FileFormatClicked / FileEncodingClicked。変換の入口に使う）。
                     幅は変更印 → ファイル名 → 改行形式 → 文字コードの順に残す（PriorityLinePanel。未保存の印は狭くても消さない）。 -->
                <!-- 文字色・地の色は Theme から塗る（VimStatusBar.ApplyTheme）。 -->
                <local:PriorityLinePanel x:Name="FileInfoPanel" ClipToBounds="True" VerticalAlignment="Center" Margin="8,0" HorizontalAlignment="Left">
                    <TextBlock x:Name="FileText" local:PriorityLinePanel.Priority="1"
                               FontFamily="Cascadia Code, Consolas" FontSize="12"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="FormatText" local:PriorityLinePanel.Priority="2"
                               FontFamily="Cascadia Code, Consolas" FontSize="12"
                               VerticalAlignment="Center" Background="Transparent"
                               MouseLeftButtonUp="OnFormatTextClicked"/>
                    <TextBlock x:Name="EncodingText" local:PriorityLinePanel.Priority="3"
                               FontFamily="Cascadia Code, Consolas" FontSize="12"
                               VerticalAlignment="Center" Background="Transparent"
                               MouseLeftButtonUp="OnEncodingTextClicked"/>
                    <TextBlock x:Name="ModifiedText" local:PriorityLinePanel.Priority="0"
                               FontFamily="Cascadia Code, Consolas" FontSize="12"
                               VerticalAlignment="Center"/>
                </local:PriorityLinePanel>
                <TextBlock x:Name="CommandText" FontFamily="Cascadia Code, Consolas" FontSize="13"
                           VerticalAlignment="Center" Padding="4,0"
                           TextTrimming="CharacterEllipsis"
                           Visibility="Collapsed"/>
            </Grid>

            <!-- Git branch -->
            <TextBlock x:Name="BranchText" DockPanel.Dock="Right" FontFamily="Cascadia Code, Consolas" FontSize="12"
                       VerticalAlignment="Center" Padding="8,0"
                       TextTrimming="CharacterEllipsis" MaxWidth="220" Visibility="Collapsed"/>

            <!-- Status message -->
            <TextBlock x:Name="StatusText" FontFamily="Cascadia Code, Consolas" FontSize="12"
                       VerticalAlignment="Center" Padding="8,0" TextAlignment="Right"
                       TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <!-- Cursor position -->
        <TextBlock x:Name="PosText" Grid.Column="2" FontFamily="Cascadia Code, Consolas" FontSize="12"
                   VerticalAlignment="Center" Padding="8,0" MinWidth="120" TextAlignment="Right"/>
    </Grid>
    </StackPanel>
</UserControl>
